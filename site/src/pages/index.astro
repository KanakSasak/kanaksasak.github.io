---
import Base from '../layouts/Base.astro';
import { research } from '../data/research';
const topics = ['All research', 'Malware analysis', 'Threat intelligence', 'Field notes'];
---
<Base>
<main id="main">
<section class="hero" id="top">
  <div class="atmosphere" aria-hidden="true"></div><canvas id="signal-canvas" aria-hidden="true"></canvas>
  <div class="hero-meta mono"><span><i class="status-dot"></i> INDEPENDENT CYBER THREAT RESEARCH</span><span>LOMBOK, ID <span id="local-clock">UTC+08</span></span></div>
  <div class="hero-content">
    <div class="eyebrow mono"><span class="tiny-cross">✳</span> LOOK CLOSER. QUESTION EVERYTHING.</div>
    <h1>Dissect the code.<br/>Understand the <span class="noise-word">threat<svg viewBox="0 0 400 20" preserveAspectRatio="none" aria-hidden="true"><path d="M2 13Q100 0 190 11T398 9"/></svg></span><span class="period">.</span></h1>
    <div class="hero-bottom"><p>Exploring the dark arts of cybersecurity.<br/>Diving deep into the kernel, one spell at a time.</p><a class="text-link" href="#research">Explore the research <span>↘</span></a></div>
  </div>
  <div class="specimen" aria-hidden="true"><div class="window-bar"><span>signal_observer.exe</span><span>− □ ×</span></div><div class="specimen-body"><div class="pixel-symbol">⌁</div><div><span class="status-dot"></span> OBSERVE → UNDERSTAND<br/><span class="muted">curiosity is the first tool.</span></div></div></div>
  <div class="hero-foot mono"><span>SCROLL TO INVESTIGATE ↓</span><span>[ KS — FIELD JOURNAL / 001 ]</span><span class="hero-cross">+ &nbsp; +</span></div>
</section>
<div class="signal-strip mono"><span>THE RESEARCH LOOP</span><div><span>01 / OBSERVE</span><b>⟶</b><span>02 / DISSECT</span><b>⟶</b><span>03 / CONNECT</span><b>⟶</b><span>04 / SHARE</span></div><span aria-hidden="true">✳</span></div>
<section id="research" class="research section-wrap">
  <div class="section-heading"><div><span class="section-kicker mono">01 / THE ARCHIVE</span><h2>Follow the evidence<span class="pink-dot">.</span></h2></div><p>Deep dives, unexpected connections,<br/>and a few things learned the hard way.</p></div>
  <form class="research-controls" role="search" onsubmit="return false"><div class="filter-tabs" aria-label="Filter research by topic">{topics.map((topic,i)=><button type="button" data-filter={topic} aria-pressed={i === 0} class:list={{active:i===0}}>{topic}{i===0 && <span>{research.length.toString().padStart(2,'0')}</span>}</button>)}</div><label class="search"><span aria-hidden="true">⌕</span><input type="search" id="search" placeholder="Search the archive" aria-label="Search the research archive"/><kbd>/</kbd></label></form>
  <p id="result-status" class="sr-only" aria-live="polite">4 articles</p>
  <div class="article-grid">{research.map((post,i)=><article class="research-card" data-category={post.category} data-search={`${post.title} ${post.description} ${post.tags.join(' ')}`}>
    <a class={`article-art ${post.visual}`} href={post.href} target={post.href.startsWith('https')?'_blank':undefined} rel={post.href.startsWith('https')?'noopener noreferrer':undefined} aria-label={`Read ${post.title}`}>
      <div class="art-top mono"><span>RESEARCH FILE / {String(i+1).padStart(3,'0')}</span><span>↗</span></div>
      {post.visual==='loader' && <div class="loader-diagram"><div class="file-node"><span>⌘</span>repository.zip</div><div class="flow-line"></div><div class="file-node central"><span>⌁</span>LuaJIT</div><div class="flow-line"></div><div class="file-node"><span>⌖</span>payload</div></div>}
      {post.visual==='akira' && <div class="akira-art"><span class="binary-text">01100001 01101011 01101001 01110010 01100001</span><strong>AKIRA<span>_</span></strong><span class="binary-text">[ INSIDE THE BINARY ]</span></div>}
      {post.visual==='signal' && <div class="signal-art"><div class="waveform">{Array.from({length:43},(_,j)=><i style={`--height:${12+Math.abs(Math.sin(j*1.9)*Math.cos(j*.3))*90}%;--delay:${j*-.07}s`}></i>)}</div><span class="mono">NOISE → CONTEXT → INTELLIGENCE</span></div>}
      {post.visual==='notes' && <div class="notes-art"><span class="mono">~/research/notebook</span><strong>Stay curious<span class="cursor">_</span></strong><span class="mono">&gt; follow the anomaly</span></div>}
      <div class="art-bottom mono"><span>{post.tags[0]}</span><span>{post.featured?'SELECTED RESEARCH':'OPEN FILE ↗'}</span></div>
    </a><div class="card-meta mono"><span>{post.kind}</span>{post.date?<time datetime={post.date}>{post.displayDate}</time>:<span>{post.displayDate}</span>}</div>
    <h3><a href={post.href} target={post.href.startsWith('https')?'_blank':undefined} rel={post.href.startsWith('https')?'noopener noreferrer':undefined}>{post.title}<span>↗</span></a></h3><p>{post.description}</p><div class="card-footer mono"><span>{post.tags.map(tag=><span class="tag">{tag}</span>)}</span><span>{post.source}{post.href.startsWith('https')?' ↗':''}</span></div>
  </article>)}</div>
  <div id="no-results" hidden><span class="mono">[ NO MATCHES FOUND ]</span><h3>A quiet corner of the archive.</h3><p>Try another search or topic.</p><button type="button" id="clear-search">Reset filters ↗</button></div>
  <p class="archive-note mono">↗ External research opens at its original publication. New field notes live here.</p>
</section>
<section class="tools section-wrap" id="tools"><div class="section-heading"><div><span class="section-kicker mono">02 / BUILT TO INVESTIGATE</span><h2>Tools from the lab<span class="pink-dot">.</span></h2></div><a class="text-link" href="https://github.com/KanakSasak" target="_blank" rel="noopener noreferrer">All repositories ↗</a></div><div class="tool-list">{[
{name:'procSniper',type:'DETECTION ENGINEERING',description:'Behavioral ransomware prevention with local machine learning.',href:'procSniper',icon:'⌖'},
{name:'CupaX Sandbox',type:'MALWARE ANALYSIS',description:'An isolated environment to observe what suspicious files do.',href:'cupax-sandbox',icon:'⬡'},
{name:'Searchable Encryption',type:'CRYPTOGRAPHY',description:'Exploring search over encrypted data through a Go implementation.',href:'Searchable-Symmetric-Encryption-SSE',icon:'⌘'}
].map((tool,i)=><a class="tool-row" href={`https://github.com/KanakSasak/${tool.href}`} target="_blank" rel="noopener noreferrer"><span class="mono">0{i+1}</span><span class="tool-icon" aria-hidden="true">{tool.icon}</span><div><span class="mono">{tool.type}</span><h3>{tool.name}</h3></div><p>{tool.description}</p><span class="tool-arrow">↗</span></a>)}</div></section>
<section class="about section-wrap" id="about"><div class="about-mark" aria-hidden="true">✳</div><div><span class="section-kicker mono">03 / THE HUMAN BEHIND THE HANDLE</span><h2>whoami</h2><p>I’m <strong>Lalu Raynaldi Pratama Putra</strong>, also known as <strong>KanakSasak</strong>—a Threat Researcher specializing in malware analysis, reverse engineering, AI-driven threat detection, and detection engineering.</p><p>I lead cybersecurity research and innovation initiatives, developing AI-powered security solutions and advanced detection capabilities. My work spans sophisticated malware, ransomware, and advanced persistent threats, turning research into practical defenses against emerging threats.</p><p>I’m a <strong>Black Hat Asia 2026 Arsenal Presenter</strong>, a court-recognized expert witness in malware investigations, and a contributor to the global security community through technical publications, IEEE-indexed research, and international conference presentations.</p><dl class="researcher-credentials"><div><dt>EXPERTISE</dt><dd>Malware reverse engineering · Detection engineering · AI for cybersecurity · Digital forensics · Security R&amp;D</dd></div></dl><div class="about-links"><a href="https://github.com/KanakSasak" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="https://medium.com/@kanaksasak" target="_blank" rel="noopener noreferrer">Medium ↗</a><a href="https://www.linkedin.com/in/raynaldilalu" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div><span class="about-code mono">OBSERVE.<br/>QUESTION.<br/>REPEAT.</span></section>
</main>
<script>
  const input = document.querySelector<HTMLInputElement>('#search')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.research-card')];
  let active = 'All research';
  function filter() {
    const query = input.value.toLowerCase().trim(); let count = 0;
    cards.forEach(card => {const visible = (active === 'All research' || card.dataset.category === active) && (card.dataset.search || '').toLowerCase().includes(query); card.hidden = !visible; if(visible) count++;});
    document.querySelector<HTMLElement>('#no-results')!.hidden = count !== 0;
    document.querySelector('#result-status')!.textContent = `${count} article${count === 1?'':'s'}`;
    buttons.forEach(button=>{const selected = button.dataset.filter === active; button.classList.toggle('active',selected);button.setAttribute('aria-pressed',String(selected));});
  }
  buttons.forEach(button=>button.addEventListener('click',()=>{active=button.dataset.filter!;filter();}));
  input.addEventListener('input',filter);
  document.querySelector('#clear-search')!.addEventListener('click',()=>{active='All research';input.value='';filter();input.focus();});
  document.addEventListener('keydown',event=>{const target = event.target as HTMLElement;if(event.key==='/'&&!['INPUT','TEXTAREA','SELECT'].includes(target.tagName)&&!target.isContentEditable){event.preventDefault();input.focus();}if(event.key==='Escape'&&document.activeElement===input){input.value='';filter();input.blur();}});
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const canvas = document.querySelector<HTMLCanvasElement>('#signal-canvas')!;
  const ctx = canvas.getContext('2d');
  let frame=0, last=0, tick=0;
  function draw(time:number) {
    if(!ctx)return;
    if(time-last>65){last=time;const {width:w,height:h}=canvas;ctx.clearRect(0,0,w,h);tick+=.015;
      for(let x=0;x<w;x+=15){for(let y=0;y<h;y+=15){const wave=Math.sin(x*.006+tick)*45+Math.cos(x*.012-tick)*20;const distance=Math.abs(y-h*.35-wave);if(distance<100){ctx.fillStyle=`rgba(83,46,128,${(1-distance/100)*.3})`;ctx.fillRect(x,y,1.5,1.5);}}}
    }
    if(!motion.matches&&!document.hidden)frame=requestAnimationFrame(draw);
  }
  function resize(){canvas.width=canvas.clientWidth;canvas.height=canvas.clientHeight;}
  resize();window.addEventListener('resize',resize);draw(100);
  function resume(){cancelAnimationFrame(frame);draw(performance.now()+100);}
  document.addEventListener('visibilitychange',resume);motion.addEventListener('change',resume);
  const clock=document.querySelector('#local-clock')!;
  function updateClock(){clock.textContent=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Makassar',hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date())+' WITA';}
  updateClock();setInterval(updateClock,1000);
</script>
</Base>
